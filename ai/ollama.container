[Unit]
Requires=ai-network.service rss-network.service
After=ai-network.service rss-network.service

[Container]
ContainerName=ollama
Image=docker.io/ollama/ollama
Volume=/mnt/volumes/ollama:/root/.ollama:Z

# AMD GPU access
AddDevice=/dev/kfd
AddDevice=/dev/dri

PublishPort=11434:11434/tcp

# used by both librechat & upvote-rss
Network=ai-network
Network=rss-network

# default is 5m
Environment=OLLAMA_KEEP_ALIVE=30s

# default is unlimited
Environment=OLLAMA_MAX_LOADED_MODELS=1

# === Notes on picking models ===
# https://ollama.com/library
# My GPU has 8Gb VRAM, which means 16b<= models only
# lower params is faster but less accurate
# https://aider.chat/docs/leaderboards

# popular models
# - qwen
# - deepseek-r1 [thinking]
# - deepseek
# - qwen-coder
# - deepseek-coder

# there are image models (x/z-image-turbo) coming but are not supporting linux yet

# ollama CLI commands
# - ollama list
# - ollama rm qwen3:8b
# - ollama pull qwen3:8b
# - ollama run qwen3:8b "say hello"

# if you change the models, have librechat match in ./librechat.yaml

# env vars can be found here:
# https://github.com/ollama/ollama/blob/main/envconfig/config.go

# auto update
AutoUpdate=registry

[Service]
# allow time for a new image to download
TimeoutStartSec=900
Restart=always

[Install]

# automatic startup
WantedBy=default.target
