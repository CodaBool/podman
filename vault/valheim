[Container]
ContainerName=valheim
# https://foundryvtt.com/releases
Environment="SERVER_NAME=Placeholder"
Environment="WORLD_NAME=placeholder"
Environment=SERVER_PUBLIC=false
#Environment=PUID=1000
#Environment=PGID=1000
Environment=BEPINEX=true
EnvironmentFile=/mnt/volumes/.valheim.env
Image=ghcr.io/community-valheim-tools/valheim-server
PublishPort=2456-2457:2456-2457/udp
PublishPort=9001:9001/tcp
Volume=/mnt/volumes/valheim:/config:Z
Volume=/mnt/volumes/valheim_config:/opt/valheim:Z


AddCapability=CAP_SYS_NICE
StopTimeout=120

#UserNS=keep-id

# auto update
AutoUpdate=registry

[Service]

# allow time for a new image to download
TimeoutStartSec=900
Restart=always

[Install]

# automatic startup
WantedBy=default.target
