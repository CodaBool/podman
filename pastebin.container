[Container]
ContainerName=pastebin
# it's been 1 year since a release, consider another image
# microbin is active again = https://github.com/szabodanika/microbin
Image=docker.io/corentinth/enclosed
PublishPort=8081:8787
Volume=/mnt/volumes/pastebin:/app/.data:Z

# auto update
AutoUpdate=registry

[Service]

# allow time for a new image to download
TimeoutStartSec=900
Restart=always

[Install]

# automatic startup
WantedBy=default.target
