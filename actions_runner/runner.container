[Container]
ContainerName=runner
# https://github.com/actions/runner/pkgs/container/actions-runner
Image=ghcr.io/actions/actions-runner

# env has
# GH_PAT=   fine-grained PAT, only CodaBool/podman, "Administration: Read and write"
EnvironmentFile=/mnt/volumes/.actions_runner.env
Environment=GH_REPO=CodaBool/podman
# target with: runs-on: self-hosted

Volume=%h/.config/containers/systemd/actions_runner/entrypoint.sh:/entrypoint.sh:ro,Z
Entrypoint=/bin/bash
Exec=/entrypoint.sh

# other LAN devices are still reachable.
Network=pasta:--no-map-gw,--map-guest-addr,none

# allow runner to build and push images
Volume=%t/podman/podman.sock:/run/podman/podman.sock
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Environment=PODMAN_VERSION=5.8.9
# map host uid 1000 (socket owner) to the image's runner user (1001)
UserNS=keep-id:uid=1001,gid=1001
# access podman.sock
SecurityLabelDisable=true

# auto update
AutoUpdate=registry

[Unit]
Requires=podman.socket
After=podman.socket

[Service]
# allow time for a new image to download
TimeoutStartSec=900
Restart=always
RestartSec=10

[Install]
# automatic startup
WantedBy=default.target
