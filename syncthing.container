[Container]
ContainerName=syncthing
Environment=PUID=1000
Environment=PGID=1000
User=1000:1000
UserNS=keep-id

# https://github.com/syncthing/syncthing/releases
Image=docker.io/syncthing/syncthing:2.1.7

# web ui, loopback only
PublishPort=127.0.0.1:8384:8384
# tcp file transfers (port forward this on the router)
PublishPort=22000:22000/tcp
# quic file transfers
PublishPort=22000:22000/udp
# local discovery (21027/udp) can't broadcast from a container, global discovery and relays still work

Volume=/mnt/volumes/foundry/Data:/var/syncthing:z

# auto update
AutoUpdate=registry

[Service]

# allow time for a new image to download
TimeoutStartSec=900
Restart=always

[Install]

# automatic startup
WantedBy=default.target
