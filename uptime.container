[Container]
ContainerName=uptime
# https://github.com/louislam/uptime-kuma/releases
# pinned: has the podman socket, so Renovate bumps it after a 7 day wait instead of floating
Image=docker.io/louislam/uptime-kuma:2.5.9
PublishPort=3001:3001
Volume=/mnt/volumes/uptime:/app/data:Z
Volume=/run/user/1000/podman/podman.sock:/run/user/1000/podman/podman.sock:z,ro

# allows for uptime to reach other containers
Network=host

# needed to access podman.sock
SecurityLabelDisable=true

# auto update
AutoUpdate=registry

[Service]

# allow time for a new image to download
TimeoutStartSec=900
Restart=always

[Install]

# automatic startup
WantedBy=default.target
