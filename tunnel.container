# tunnel.container
[Container]
ContainerName=tunnel
Environment=TUNNEL_METRICS=127.0.0.1:60123

# env has
# TUNNEL_TOKEN=

EnvironmentFile=/mnt/volumes/.tunnel.env
Exec=tunnel run
Image=docker.io/cloudflare/cloudflared
Network=host

# auto update
AutoUpdate=registry

[Service]

# allow time for a new image to download
TimeoutStartSec=900
Restart=always

[Install]

# automatic startup
WantedBy=default.target
