[Unit]
Requires=rss-network.service
After=rss-network.service

[Container]
ContainerName=changedetect
Environment=PLAYWRIGHT_DRIVER_URL=ws://rsspuppet:3000
Environment=TZ=America/New_York

# https://github.com/dgtlmoon/changedetection.io/releases
Image=ghcr.io/dgtlmoon/changedetection.io
PublishPort=5000:5000
Volume=/mnt/volumes/changedetect:/datastore:z
Network=rss-network

# auto update
AutoUpdate=registry

[Service]

# allow time for a new image to download
TimeoutStartSec=900
Restart=always

[Install]

# automatic startup
WantedBy=default.target
